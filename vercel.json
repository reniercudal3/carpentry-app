{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/Compass.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=Compass.apk" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!Compass\\.apk$).*)", "destination": "/index.html" }
  ]
}
